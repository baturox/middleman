<mxfile host="drawio-mcp">
  <diagram id="middleman-flow" name="How a delegation stays private">
    <mxGraphModel background="#FFFFFF" adaptiveColors="none" grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="middleman: how a delegation stays private" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="640" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="claude" value="Claude Code&lt;br&gt;&lt;small&gt;sends paths, not code&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="box" value="middleman · on your machine" style="swimlane;startSize=26;html=1;fontSize=14;fontStyle=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="540" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="1 · Read files&lt;br&gt;&lt;small&gt;skips .env and keys&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="box">
          <mxGeometry x="20" y="50" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="2 · Detect&lt;br&gt;&lt;small&gt;secrets · PII · names&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="box">
          <mxGeometry x="200" y="50" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="3 · Safe and&lt;br&gt;worth it?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="box">
          <mxGeometry x="370" y="35" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="4 · Fake names&lt;br&gt;&lt;small&gt;+ egress re-scan&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="box">
          <mxGeometry x="380" y="170" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ledger" value="Ledger&lt;br&gt;&lt;small&gt;model · cost · saving&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="box">
          <mxGeometry x="200" y="165" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="5 · Restore names&lt;br&gt;&lt;small&gt;write result to file&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="box">
          <mxGeometry x="20" y="170" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="blocked" value="Blocked&lt;br&gt;&lt;small&gt;Claude does it itself&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="800" y="160" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="provider" value="Cheap model on OpenRouter&lt;br&gt;&lt;small&gt;DeepSeek · Qwen · GLM · Kimi&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="540" y="420" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Fails closed: if anything is unclear, nothing is sent.&lt;br&gt;Dashed = written to the local log." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=12;align=left;spacingLeft=8;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="800" y="250" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;endArrow=block;endFill=1;" edge="1" parent="1" source="claude" target="n1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="box" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="box" source="n2" target="d3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#C9302C;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="blocked">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#1E7F3E;endArrow=block;endFill=1;" edge="1" parent="box" source="d3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="sanitised text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="provider">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="provider" target="n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="summary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n5" target="claude">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B9A6F0;dashed=1;endArrow=open;" edge="1" parent="box" source="n5" target="ledger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
